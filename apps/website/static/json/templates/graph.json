{
  "$schema": "../../multigauge-core/docs/schemas/gauge.schema.json",
  "bgColor": "#0b0f14",
  "layout": {
    "flex-container": {
      "direction": "column",
      "justify": "center",
      "align-items": "center"
    },
    "padding": {
      "left": 16,
      "right": 16,
      "top": 16,
      "bottom": 16
    }
  },
  "children": [
    {
      "type": "graph",
      "style": {
        "width": "100%",
        "height": "100%"
      },
      "value": {
        "id": "engineRPM",
        "min": 0,
        "max": 8000
      },
      "seconds": 10,
      "graphColor": {
        "type": "static",
        "color": "#22c55e"
      },
      "secondsColor": {
        "type": "static",
        "color": "#94a3b8"
      },
      "valueColor": {
        "type": "static",
        "color": "#ffffff"
      },
      "borderColor": {
        "type": "static",
        "color": "#ffffff"
      },
      "bgColor": {
        "type": "static",
        "color": "#07111BFF"
      },
      "groundColor": {
        "type": "static",
        "color": "#0f172a"
      },
      "children": []
    }
  ]
}
