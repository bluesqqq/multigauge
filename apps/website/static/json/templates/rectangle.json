{
  "$schema": "../../multigauge-core/docs/schemas/gauge.schema.json",
  "bgColor": "#ffffff",
  "layout": {
    "flex-container": {
      "direction": "column",
      "justify": "center",
      "align-items": "center"
    },
    "padding": {
      "left": 10,
      "right": 10,
      "top": 10,
      "bottom": 10
    }
  },
  "children": [
    {
      "type": "rectangle",
      "style": {
        "width": "100%",
        "height": "100%"
      },
      "paint": {
        "fill": "#22c55e"
      },
      "radius": 8,
      "children": []
    }
  ]
}
