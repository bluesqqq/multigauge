{
  "$schema": "../../multigauge-core/docs/schemas/gauge.schema.json",
  "bgColor": "#07111BFF",
  "layout": {
    "flex-container": {
      "direction": "column",
      "justify": "flex-start",
      "gap": {
        "row": 8
      }
    },
    "padding": {
      "left": 10,
      "right": 10,
      "top": 10,
      "bottom": 10
    }
  },
  "children": [
    {
      "type": "circular-element",
      "style": {
        "width": "100%",
        "height": "100%"
      },
      "startAngle": 150,
      "endAngle": 390,
      "value": {
        "id": "engineRPM",
        "min": 0,
        "max": 8000
      },
      "children": [
        {
          "type": "circular-scale",
          "style": {
            "position": {
              "type": "absolute",
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            }
          },
          "radius": 1,
          "ticks": {
            "root": {
              "interval": 1000,
              "useDivisions": false,
              "length": 12,
              "thickness": 3,
              "paint": {
                "fill": {
                  "type": "static",
                  "color": "#74C0FCFF"
                },
                "thickness": 1
              }
            },
            "subs": [
              {
                "divisions": 4,
                "length": 6,
                "thickness": 2,
                "paint": {
                  "fill": {
                    "type": "static",
                    "color": "#35546EFF"
                  },
                  "thickness": 1
                }
              }
            ]
          }
        },
        {
          "type": "circular-needle",
          "style": {
            "position": {
              "type": "absolute",
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            }
          },
          "radius": 0.63,
          "paint": {
            "fill": {
              "type": "static",
              "color": "#F97316FF"
            },
            "stroke": {
              "type": "static",
              "color": "#FFD8A8FF"
            },
            "thickness": 2
          }
        }
      ]
    }
  ]
}
