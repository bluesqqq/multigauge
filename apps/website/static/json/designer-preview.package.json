{
  "name": "Designer Preview Pack",
  "author": "Multigauge",
  "description": "Homepage gauge preview presets for the designer section.",
  "faces": [
    {
      "name": "RPM",
      "face": {
        "bgColor": "#0b0f14",
        "layout": {
          "flex-container": {
            "direction": "column",
            "justify": "center",
            "align-items": "center"
          },
          "padding": {
            "left": 10,
            "right": 10,
            "top": 10,
            "bottom": 10
          }
        },
        "children": [
          {
            "type": "circular-element",
            "style": {
              "width": "100%",
              "height": "100%"
            },
            "startAngle": 150,
            "endAngle": 390,
            "value": {
              "id": "engineRPM",
              "min": 0,
              "max": 8000
            },
            "children": [
              {
                "type": "circular-scale",
                "style": {
                  "position": {
                    "type": "absolute",
                    "left": 0,
                    "right": 0,
                    "top": 0,
                    "bottom": 0
                  }
                },
                "radius": 1,
                "ticks": {
                  "root": {
                    "interval": 1000,
                    "useDivisions": false,
                    "length": 12,
                    "thickness": 3,
                    "paint": {
                      "fill": {
                        "type": "static",
                        "color": "#ff4d2e"
                      },
                      "stroke": {
                        "keyframes": []
                      },
                      "thickness": 1
                    }
                  },
                  "subs": [
                    {
                      "divisions": 4,
                      "length": 6,
                      "thickness": 2,
                      "paint": {
                        "fill": {
                          "type": "static",
                          "color": "#6b7280"
                        },
                        "stroke": {
                          "keyframes": []
                        },
                        "thickness": 1
                      }
                    }
                  ],
                  "offset": 0
                }
              },
              {
                "type": "circular-needle",
                "style": {
                  "position": {
                    "type": "absolute",
                    "left": 0,
                    "right": 0,
                    "top": 0,
                    "bottom": 0
                  }
                },
                "radius": 0.63,
                "paint": {
                  "fill": {
                    "type": "static",
                    "color": "#ff4d2e"
                  },
                  "stroke": {
                    "type": "static",
                    "color": "#ffd8a8"
                  },
                  "thickness": 2
                }
              }
            ]
          }
        ]
      }
    },
