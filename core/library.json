{
  "name": "multigauge-core",
  "build": {
    "srcDir": ".",
    "includeDir": "include",
    "srcFilter": [
      "+<src/**>",
      "+<lib/yoga/src/**>",
      "+<*>",
      "+<lib/lodepng/src/lodepng.cpp>"
    ],
    "flags": [
      "-Ilib/rapidjson/src",
      "-Ilib/lodepng/src",
      "-Ilib/tjpgd/src",
      "-Ilib/yoga/src"
    ]
  }
}
