{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.multi-gauge.com/schemas/values.schema.json",
  "title": "Values Schema",
  "description": "Schema for the registered value catalog used by the editor and runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional. JSON Schema reference for editor tooling."
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Catalog format version."
    },
    "values": {
      "type": "array",
      "description": "Flat list of registered values.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/value"
      }
    }
  },
  "required": [
    "version",
    "values"
  ],
  "$defs": {
    "unitType": {
      "type": "string",
      "enum": [
        "temperature",
        "distance",
        "pressure",
        "velocity",
        "acceleration",
        "volume",
        "volumePerTime",
        "revolutions",
        "angle",
        "percentage"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "powertrain",
        "fuel",
        "vehicle",
        "motion"
      ]
    },
    "tag": {
      "type": "string",
      "enum": [
        "system",
        "placeholder",
        "engine",
        "transmission",
        "temperature",
        "pressure",
        "fuel",
        "level",
        "vehicle",
        "distance",
        "speed",
        "motion",
        "acceleration",
        "performance",
        "rate"
      ]
    },
    "valueId": {
      "type": "string",
      "description": "Stable identifier used to resolve values at runtime.",
      "pattern": "^(n\\/a|[A-Za-z][A-Za-z0-9_]*)$"
    },
    "valueName": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "unitType",
        "minimum",
        "maximum",
        "category",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/valueId"
        },
        "name": {
          "$ref": "#/$defs/valueName"
        },
        "unitType": {
          "$ref": "#/$defs/unitType"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "values": [
        {
          "id": "engineRPM",
          "name": "RPM",
          "unitType": "revolutions",
          "minimum": 0.0,
          "maximum": 8000.0,
          "category": "powertrain",
          "tags": [
            "engine",
            "performance"
          ]
        }
      ]
    }
  ]
}
