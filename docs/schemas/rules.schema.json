{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.multi-gauge.com/schemas/rules.schema.json",
  "title": "Inspector Rule Schema",
  "description": "Schema for editor-facing property visibility and interactability rules emitted by PropertyObject metadata.",
  "$ref": "#/$defs/ruleList",
  "$defs": {
    "stringValue": {
      "type": "string",
      "description": "Single comparison value."
    },
    "stringValueList": {
      "type": "array",
      "description": "Comparison list used by membership operators such as 'in' and 'notIn'.",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "ruleValue": {
      "description": "Rules emitted by the core currently compare against string values or arrays of strings.",
      "oneOf": [
        {
          "$ref": "#/$defs/stringValue"
        },
        {
          "$ref": "#/$defs/stringValueList"
        }
      ]
    },
    "simpleRule": {
      "type": "object",
      "description": "Single rule comparing a property path to a value.",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Property path evaluated by the editor. Paths may be relative, for example 'wrap' or '../direction'."
        },
        "op": {
          "type": "string",
          "description": "Operator name. Common values emitted by the core are '==', '!=', 'in', and 'notIn'."
        },
        "value": {
          "$ref": "#/$defs/ruleValue"
        }
      },
      "required": [
        "path",
        "op",
        "value"
      ]
    },
    "allGroup": {
      "type": "object",
      "description": "Logical AND group. All child rules must pass.",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleNode"
          },
          "minItems": 1
        }
      },
      "required": [
        "all"
      ]
    },
    "anyGroup": {
      "type": "object",
      "description": "Logical OR group. At least one child rule must pass.",
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleNode"
          },
          "minItems": 1
        }
      },
      "required": [
        "any"
      ]
    },
    "ruleNode": {
      "description": "A single rule node, either a simple comparison or a nested logical group.",
      "oneOf": [
        {
          "$ref": "#/$defs/simpleRule"
        },
        {
          "$ref": "#/$defs/allGroup"
        },
        {
          "$ref": "#/$defs/anyGroup"
        }
      ]
    },
    "ruleList": {
      "type": "array",
      "description": "Top-level rule list emitted for visibleWhen and interactableWhen metadata.",
      "items": {
        "$ref": "#/$defs/ruleNode"
      }
    }
  },
  "examples": [
    [
      {
        "path": "wrap",
        "op": "!=",
        "value": "no-wrap"
      }
    ],
    [
      {
        "any": [
          {
            "path": "../wrap",
            "op": "!=",
            "value": "no-wrap"
          },
          {
            "path": "../direction",
            "op": "in",
            "value": [
              "column",
              "column-reverse"
            ]
          }
        ]
      }
    ]
  ]
}
