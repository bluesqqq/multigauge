{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.multi-gauge.com/schemas/library.schema.json",
  "title": "Multigauge Library Index Schema",
  "description": "Schema for the device library index. It lists installed packages using stable internal IDs and user-facing metadata.",
  "type": "object",
  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packageSummary"
      }
    }
  },
  "required": [
    "packages"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "packageSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "author": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "favorite": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "author",
        "description",
        "favorite"
      ],
      "additionalProperties": false
    }
  }
}
