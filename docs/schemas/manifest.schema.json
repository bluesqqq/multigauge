{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.multi-gauge.com/schemas/manifest.schema.json",
  "title": "Multigauge Package Manifest Schema",
  "description": "Schema for an installed package manifest. The manifest stores package metadata and the installed face list without package ids or storage paths.",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "author": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "description": {
      "type": "string"
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/faceEntry"
      }
    }
  },
  "required": [
    "name",
    "author",
    "description",
    "faces"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "faceEntry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
