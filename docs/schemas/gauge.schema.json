{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.multi-gauge.com/schemas/gauge.schema.json",
  "title": "Gauge Face Schema",
  "description": "Schema for the JSON consumed by mg::gauge::GaugeFace::load and mg::gauge::Element::fromJson. The runtime loads a face object with optional 'layout' and 'children' members, and generally ignores unknown object members instead of rejecting them.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema reference for tooling."
    },
    "layout": {
      "$ref": "#/$defs/rootLayout"
    },
    "children": {
      "$ref": "#/$defs/children"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stringOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "numberOrNull": {
      "type": [
        "number",
        "null"
      ]
    },
    "integerOrNull": {
      "type": [
        "integer",
        "null"
      ]
    },
    "valueId": {
      "type": "string",
      "description": "Runtime lookup key for mg::ValueRef. The loader accepts any string; unresolved ids simply leave the reference unresolved."
    },
    "layoutSize": {
      "description": "Matches mg::gauge::LayoutSize. Accepted forms are a number, 'auto', '<n>', '<n>px', or '<n>%'.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^(auto|-?(?:(?:\\d+(?:\\.\\d+)?)|(?:\\.\\d+))(?:(?:px)|(?:%))?)$"
        }
      ]
    },
    "layoutBox": {
      "type": "object",
      "properties": {
        "left": {
          "$ref": "#/$defs/layoutSize"
        },
        "right": {
          "$ref": "#/$defs/layoutSize"
        },
        "top": {
          "$ref": "#/$defs/layoutSize"
        },
        "bottom": {
          "$ref": "#/$defs/layoutSize"
        }
      },
      "additionalProperties": true
    },
    "gap": {
      "type": "object",
      "properties": {
        "row": {
          "type": "number"
        },
        "column": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "ygFlexDirection": {
      "type": "string",
      "enum": [
        "row",
        "column",
        "row-reverse",
        "column-reverse"
      ]
    },
    "ygJustify": {
      "type": "string",
      "enum": [
        "flex-start",
        "center",
        "flex-end",
        "space-between",
        "space-around",
        "space-evenly"
      ]
    },
    "ygAlign": {
      "type": "string",
      "enum": [
        "flex-start",
        "center",
        "flex-end"
      ],
      "description": "These are the only values currently decodable by the YGAlign codec. Values such as 'stretch' or 'auto' are not loaded from JSON even though Yoga supports them internally."
    },
    "ygWrap": {
      "type": "string",
      "enum": [
        "no-wrap",
        "wrap",
        "wrap-reverse"
      ]
    },
    "ygPositionType": {
      "type": "string",
      "enum": [
        "static",
        "relative",
        "absolute"
      ]
    },
    "ygDisplay": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "ygOverflow": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ]
    },
    "flexContainer": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/ygFlexDirection"
        },
        "justify": {
          "$ref": "#/$defs/ygJustify"
        },
        "align-items": {
          "$ref": "#/$defs/ygAlign"
        },
        "align-content": {
          "$ref": "#/$defs/ygAlign"
        },
        "wrap": {
          "$ref": "#/$defs/ygWrap"
        },
        "gap": {
          "$ref": "#/$defs/gap"
        }
      },
      "additionalProperties": true
    },
    "flexItem": {
      "type": "object",
      "properties": {
        "grow": {
          "type": "number"
        },
        "shrink": {
          "type": "number"
        },
        "basis": {
          "$ref": "#/$defs/layoutSize"
        },
        "align-self": {
          "$ref": "#/$defs/ygAlign"
        }
      },
      "additionalProperties": true
    },
    "position": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/ygPositionType"
        },
        "left": {
          "$ref": "#/$defs/layoutSize"
        },
        "right": {
          "$ref": "#/$defs/layoutSize"
        },
        "top": {
          "$ref": "#/$defs/layoutSize"
        },
        "bottom": {
          "$ref": "#/$defs/layoutSize"
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "properties": {
        "flex-container": {
          "$ref": "#/$defs/flexContainer"
        },
        "flex-item": {
          "$ref": "#/$defs/flexItem"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "margin": {
          "$ref": "#/$defs/layoutBox"
        },
        "padding": {
          "$ref": "#/$defs/layoutBox"
        },
        "overflow": {
          "$ref": "#/$defs/ygOverflow"
        },
        "display": {
          "$ref": "#/$defs/ygDisplay"
        },
        "width": {
          "$ref": "#/$defs/layoutSize"
        },
        "height": {
          "$ref": "#/$defs/layoutSize"
        },
        "min-width": {
          "$ref": "#/$defs/layoutSize"
        },
        "min-height": {
          "$ref": "#/$defs/layoutSize"
        },
        "max-width": {
          "$ref": "#/$defs/layoutSize"
        },
        "max-height": {
          "$ref": "#/$defs/layoutSize"
        },
        "aspect-ratio": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "rootLayout": {
      "type": "object",
      "properties": {
        "flex-container": {
          "$ref": "#/$defs/flexContainer"
        },
        "padding": {
          "$ref": "#/$defs/layoutBox"
        }
      },
      "additionalProperties": true
    },
    "hexColor": {
      "type": "string",
      "pattern": "^(?:#|0[xX])(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "rgbFunction": {
      "type": "string",
      "pattern": "^rgb\\(\\s*-?\\d+\\s*,\\s*-?\\d+\\s*,\\s*-?\\d+\\s*\\)$"
    },
    "rgbaFunction": {
      "type": "string",
      "pattern": "^rgba\\(\\s*-?\\d+\\s*,\\s*-?\\d+\\s*,\\s*-?\\d+\\s*,\\s*-?\\d+\\s*\\)$"
    },
    "namedColor": {
      "type": "string",
      "enum": [
        "black",
        "grey",
        "light-grey",
        "white",
        "red",
        "orange",
        "yellow",
        "lime",
        "green",
        "teal",
        "aqua",
        "blue",
        "magenta",
        "violet",
        "purple"
      ]
    },
    "rgba": {
      "description": "String form accepted by mg::Codec<rgba>.",
      "anyOf": [
        {
          "$ref": "#/$defs/hexColor"
        },
        {
          "$ref": "#/$defs/rgbFunction"
        },
        {
          "$ref": "#/$defs/rgbaFunction"
        },
        {
          "$ref": "#/$defs/namedColor"
        }
      ]
    },
    "staticColor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "static"
        },
        "color": {
          "$ref": "#/$defs/rgba"
        }
      },
      "additionalProperties": true
    },
    "staticColorNoType": {
      "type": "object",
      "description": "Object form without a type tag. The runtime falls back to StaticColor when no recognized type is supplied.",
      "properties": {
        "color": {
          "$ref": "#/$defs/rgba"
        }
      },
      "additionalProperties": true
    },
    "colorKeyframe": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": true
    },
    "colorTimelineObject": {
      "type": "object",
      "properties": {
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/colorKeyframe"
          }
        }
      },
      "additionalProperties": true
    },
    "colorTimeline": {
      "description": "ColorTimeline accepts a color shorthand or an object with 'keyframes'. Array shorthand is not supported by the current loader.",
      "anyOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "$ref": "#/$defs/colorTimelineObject"
        }
      ]
    },
    "valueColor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "value"
        },
        "timeline": {
          "$ref": "#/$defs/colorTimeline"
        },
        "id": {
          "$ref": "#/$defs/stringOrNull"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "timeColor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "time"
        },
        "timeline": {
          "$ref": "#/$defs/colorTimeline"
        },
        "loop": {
          "type": "string",
          "enum": [
            "forward",
            "reverse",
            "pingpong"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "userColor": {
      "type": "object",
      "description": "UserColor currently exposes no loadable properties. The default constructor slot is used.",
      "properties": {
        "type": {
          "const": "user"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "unknownColorObject": {
      "type": "object",
      "description": "Fallback accepted by the runtime: unknown color types are created as a default StaticColor and then any recognized properties are loaded.",
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "color": {
      "description": "Accepted by mg::Codec<OwnedColor>: null, an rgba-like string, or an object-based color.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/rgba"
        },
        {
          "$ref": "#/$defs/staticColor"
        },
        {
          "$ref": "#/$defs/staticColorNoType"
        },
        {
          "$ref": "#/$defs/valueColor"
        },
        {
          "$ref": "#/$defs/timeColor"
        },
        {
          "$ref": "#/$defs/userColor"
        },
        {
          "$ref": "#/$defs/unknownColorObject"
        }
      ]
    },
    "paint": {
      "type": "object",
      "properties": {
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "thickness": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "paintTimeline": {
      "type": "object",
      "properties": {
        "fill": {
          "$ref": "#/$defs/colorTimeline"
        },
        "stroke": {
          "$ref": "#/$defs/colorTimeline"
        },
        "thickness": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "textPaint": {
      "type": "object",
      "description": "Only family, pt, and color are currently exposed through MG_PROPS. Weight and slant exist in memory but are not loadable from JSON.",
      "properties": {
        "family": {
          "type": "string"
        },
        "pt": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": true
    },
    "displayValueObject": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stringOrNull"
        },
        "min": {
          "$ref": "#/$defs/numberOrNull"
        },
        "max": {
          "$ref": "#/$defs/numberOrNull"
        },
        "unitIndex": {
          "$ref": "#/$defs/integerOrNull"
        }
      },
      "additionalProperties": true
    },
    "displayValue": {
      "description": "DisplayValue accepts either a string shorthand or an object. Null is not a valid top-level DisplayValue payload, but object.id may be null.",
      "anyOf": [
        {
          "$ref": "#/$defs/valueId"
        },
        {
          "$ref": "#/$defs/displayValueObject"
        }
      ]
    },
    "rootTick": {
      "type": "object",
      "description": "Only the listed RootTick properties are exposed through MG_PROPS. Internal fields such as style and valueStyle are not loadable from JSON.",
      "properties": {
        "divisions": {
          "type": "integer"
        },
        "interval": {
          "type": "number"
        },
        "useDivisions": {
          "type": "boolean"
        },
        "length": {
          "type": "number"
        },
        "thickness": {
          "type": "number"
        },
        "paint": {
          "$ref": "#/$defs/paintTimeline"
        }
      },
      "additionalProperties": true
    },
    "subTick": {
      "type": "object",
      "description": "Only the listed SubTick properties are exposed through MG_PROPS.",
      "properties": {
        "divisions": {
          "type": "integer"
        },
        "length": {
          "$ref": "#/$defs/numberOrNull"
        },
        "thickness": {
          "$ref": "#/$defs/numberOrNull"
        },
        "paint": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/paintTimeline"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "tickList": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "#/$defs/rootTick"
        },
        "subs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subTick"
          }
        },
        "offset": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "elementEnvelope": {
      "type": "object",
      "properties": {
        "style": {
          "$ref": "#/$defs/layout"
        },
        "props": {
          "type": "object"
        },
        "children": {
          "$ref": "#/$defs/children"
        }
      },
      "additionalProperties": true
    },
    "typedElementEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/elementEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "baseElement": {
      "description": "Base Element when 'type' is omitted. Only style and children are meaningful; arbitrary props are ignored.",
      "allOf": [
        {
          "$ref": "#/$defs/elementEnvelope"
        },
        {
          "not": {
            "required": [
              "type"
            ]
          }
        }
      ]
    },
    "circularProps": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/displayValue"
        },
        "startAngle": {
          "$ref": "#/$defs/numberOrNull"
        },
        "endAngle": {
          "$ref": "#/$defs/numberOrNull"
        }
      },
      "additionalProperties": true
    },
    "circleElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "circle"
            },
            "props": {
              "type": "object",
              "properties": {
                "paint": {
                  "$ref": "#/$defs/paint"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "rectangleElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "rectangle"
            },
            "props": {
              "type": "object",
              "properties": {
                "paint": {
                  "$ref": "#/$defs/paint"
                },
                "radius": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "imageElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "image"
            },
            "props": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "textElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "text"
            },
            "props": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "paint": {
                  "$ref": "#/$defs/textPaint"
                },
                "ellipses": {
                  "type": "boolean"
                },
                "hyphens": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "horizonElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "horizon"
            },
            "props": {
              "type": "object",
              "properties": {
                "bgColor": {
                  "$ref": "#/$defs/color"
                },
                "groundColor": {
                  "$ref": "#/$defs/color"
                },
                "horizonColor": {
                  "$ref": "#/$defs/color"
                },
                "borderColor": {
                  "$ref": "#/$defs/color"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "graphElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "graph"
            },
            "props": {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number"
                },
                "bgColor": {
                  "$ref": "#/$defs/color"
                },
                "secondsColor": {
                  "$ref": "#/$defs/color"
                },
                "graphColor": {
                  "$ref": "#/$defs/color"
                },
                "borderColor": {
                  "$ref": "#/$defs/color"
                },
                "value": {
                  "$ref": "#/$defs/displayValue"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "circularElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "circular-element"
            },
            "props": {
              "$ref": "#/$defs/circularProps"
            }
          }
        }
      ]
    },
    "circularNeedleElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "circular-needle"
            },
            "props": {
              "allOf": [
                {
                  "$ref": "#/$defs/circularProps"
                },
                {
                  "type": "object",
                  "properties": {
                    "paint": {
                      "$ref": "#/$defs/paint"
                    },
                    "radius": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          }
        }
      ]
    },
    "circularScaleElement": {
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "properties": {
            "type": {
              "const": "circular-scale"
            },
            "props": {
              "allOf": [
                {
                  "$ref": "#/$defs/circularProps"
                },
                {
                  "type": "object",
                  "properties": {
                    "ticks": {
                      "$ref": "#/$defs/tickList"
                    },
                    "radius": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          }
        }
      ]
    },
    "unknownTypedElement": {
      "description": "Unknown element types are still accepted by the runtime. They fall back to a base Element and then load style/children plus any recognized properties.",
      "allOf": [
        {
          "$ref": "#/$defs/typedElementEnvelope"
        },
        {
          "not": {
            "properties": {
              "type": {
                "enum": [
                  "circle",
                  "rectangle",
                  "image",
                  "text",
                  "horizon",
                  "graph",
                  "circular-element",
                  "circular-needle",
                  "circular-scale"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ]
    },
    "element": {
      "anyOf": [
        {
          "$ref": "#/$defs/baseElement"
        },
        {
          "$ref": "#/$defs/circleElement"
        },
        {
          "$ref": "#/$defs/rectangleElement"
        },
        {
          "$ref": "#/$defs/imageElement"
        },
        {
          "$ref": "#/$defs/textElement"
        },
        {
          "$ref": "#/$defs/horizonElement"
        },
        {
          "$ref": "#/$defs/graphElement"
        },
        {
          "$ref": "#/$defs/circularElement"
        },
        {
          "$ref": "#/$defs/circularNeedleElement"
        },
        {
          "$ref": "#/$defs/circularScaleElement"
        },
        {
          "$ref": "#/$defs/unknownTypedElement"
        }
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  }
}
